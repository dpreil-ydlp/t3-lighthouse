# Copy to .env. Docker Compose reads it from the repository root.

# Address the published ports bind to. 127.0.0.1 keeps every service on this machine.
# To reach Lighthouse from another machine, use a private address such as a Tailscale IP.
# Do not bind to a public interface.
LIGHTHOUSE_BIND_ADDRESS=127.0.0.1

# Host ports for the HTTP API, the MCP server, and the dashboard.
LIGHTHOUSE_API_PORT=51821
LIGHTHOUSE_MCP_PORT=51822
LIGHTHOUSE_DASHBOARD_PORT=51823

# Directory with the secret files: db-password, dashboard-session-key, t3-webhook-hmac,
# owner-token, and agent-token. Keep it mode 0700 and outside version control.
LIGHTHOUSE_SECRETS_DIR=./secrets

# The settings below are for the Mac collector and brief writer. Compose ignores them.
# Export them in the shell or the LaunchAgent environment if the defaults do not fit.
#
# Lighthouse API URL used by collector/briefs.py. collector.py takes --host instead.
# LIGHTHOUSE_API_URL=http://127.0.0.1:51821
# Local state, logs, and brief context.
# LIGHTHOUSE_CONFIG_DIR=~/.config/lighthouse
# Agent token issued by admin-entrypoint issue-principal (mode 0600).
# LIGHTHOUSE_AGENT_TOKEN_FILE=~/.config/lighthouse/secrets/agent-token
# Claude Code CLI that writes project briefs.
# LIGHTHOUSE_CLAUDE_BIN=~/.local/bin/claude
# Optional T3 Code MCP endpoint and its token file, for stall notices sent into T3 threads.
# T3_MCP_URL=http://127.0.0.1:3773/mcp
# T3_MCP_TOKEN_FILE=~/.config/lighthouse/secrets/t3-mcp-token
