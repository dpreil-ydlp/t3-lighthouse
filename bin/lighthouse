#!/usr/bin/env bash
# Manage a T3 Lighthouse install. Run `lighthouse help` for the commands.
set -euo pipefail

SELF=$0
while [ -L "$SELF" ]; do
  link=$(readlink "$SELF")
  case "$link" in /*) SELF=$link ;; *) SELF=$(dirname -- "$SELF")/$link ;; esac
done
ROOT=$(CDPATH='' cd -- "$(dirname -- "$SELF")/.." && pwd)
ENV_FILE="$ROOT/.env"
SECRETS="$ROOT/secrets"
SERVICES_HEALTHY="db api mcp worker dashboard"
LINK="$HOME/.local/bin/lighthouse"
# Set on the published images; used to find old Lighthouse images that an update left untagged.
IMAGE_LABEL="org.opencontainers.image.source=https://github.com/dpreil-ydlp/t3-lighthouse"
DEFAULT_REPO=dpreil-ydlp/t3-lighthouse
# The collector LaunchAgent this install created runs $COLLECTOR_SCRIPT; the marker file, written by
# scripts/install-mac-collector.sh, names the folder that installed the collector last. Uninstall
# removes collector files only when both point here.
COLLECTOR_SCRIPT="$ROOT/collector/collector.py"
COLLECTOR_PLIST="$HOME/Library/LaunchAgents/ai.lighthouse.collector.plist"
COLLECTOR_MARKER="$HOME/.config/lighthouse/collector-installed-by"
# T3 Code keeps its data here; when it exists, the collector links T3 projects, threads, and
# subagents, and `t3-connect` lets stall notices go into T3 threads.
T3_HOME="$HOME/.t3"
T3_TOKEN_FILE="$HOME/.config/lighthouse/secrets/t3-mcp-token"
# Names the install folder whose `t3-connect` saved the T3 token, so uninstall removes only that.
T3_MARKER="$HOME/.config/lighthouse/t3-connected-by"
# The Docker volumes this install created, one "name created-at" per line.
VOLUMES_FILE="$ROOT/.volumes"

say() { printf '%s\n' "$*"; }
step() { printf '\n==> %s\n' "$*"; }
fail() { printf 'error: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
Usage: lighthouse <command>

  status            show the containers and the dashboard address
  up                start Lighthouse
  down              stop Lighthouse (data is kept)
  logs [service]    follow the logs
  token             print the owner token for the dashboard
  agent-token       print the agent token for MCP clients and the collector
  demo [remove]     load the fictional demo projects, or remove them
  collector [--replace-collector]
                    macOS: install the Mac collector LaunchAgent
  t3-connect [--disconnect]
                    macOS: let stall notices go into T3 Code threads, or stop them
  update            download the latest version and restart
  uninstall [--yes] remove this install: containers, images, data, the install folder,
                    and the Mac collector if this install set it up
USAGE
}

# Values from .env, read without sourcing the file.
env_get() { if [ -f "$ENV_FILE" ]; then sed -n "s/^$1=//p" "$ENV_FILE" | tail -n 1; fi; }

# The Docker Compose project name. The default folder keeps the short name; any other folder gets
# a name of its own, so two installs never share containers or a database volume.
project_name() {
  local name slug
  name=$(env_get COMPOSE_PROJECT_NAME)
  [ -n "$name" ] || name=${COMPOSE_PROJECT_NAME:-}
  if [ -z "$name" ]; then
    if [ "$ROOT" = "$HOME/t3-lighthouse" ]; then
      name=t3-lighthouse
    else
      slug=$(basename -- "$ROOT" | LC_ALL=C tr '[:upper:]' '[:lower:]' | LC_ALL=C tr -c 'a-z0-9\n' '-' | sed 's/^-*//; s/-*$//' | cut -c1-30)
      name="t3-lighthouse-${slug:+$slug-}$(printf '%s' "$ROOT" | cksum | cut -d ' ' -f 1)"
    fi
  fi
  echo "$name"
}
PROJECT=$(project_name)

compose() {
  local files=(-f "$ROOT/docker-compose.yml")
  [ "$(env_get LIGHTHOUSE_BUILD)" = 1 ] && files+=(-f "$ROOT/docker-compose.build.yml")
  docker compose -p "$PROJECT" --project-directory "$ROOT" --env-file "$ENV_FILE" "${files[@]}" "$@"
}

project_volumes() { # "name created-at" for each volume of project $PROJECT
  local names
  names=$(docker volume ls -q --filter "label=com.docker.compose.project=$PROJECT") || fail "could not list the Docker volumes"
  [ -z "$names" ] && return 0
  # shellcheck disable=SC2086 # one argument per volume name
  docker volume inspect --format '{{.Name}} {{.CreatedAt}}' $names || fail "could not inspect the Docker volumes"
}

# Fails when project $PROJECT belongs to another Lighthouse install: its containers were started
# from compose files outside this folder, or it has a volume that this install cannot show it
# created (for example another install's database after that install's `lighthouse down`).
check_project_owner() {
  local files f mine=0 vol vols
  files=$(docker ps -a --filter "label=com.docker.compose.project=$PROJECT" \
    --format '{{.Label "com.docker.compose.project.config_files"}}') || fail "could not list the Docker containers"
  while IFS= read -r f; do
    case "$f" in
      "") ;;
      "$ROOT"/*) mine=1 ;;
      *) fail "the Docker Compose project \"$PROJECT\" belongs to another install (it uses $f). Nothing was changed. Give this install its own name with COMPOSE_PROJECT_NAME in $ENV_FILE, or in the environment before the first install." ;;
    esac
  done <<EOF
$(printf '%s\n' "$files" | tr ',' '\n' | sort -u)
EOF
  # Containers from this folder show the volumes are this install's too.
  [ "$mine" = 1 ] && return 0
  [ "${LIGHTHOUSE_VOLUMES_ARE_MINE:-}" = 1 ] && return 0
  vols=$(project_volumes) || exit 1
  while IFS= read -r vol; do
    [ -n "$vol" ] || continue
    grep -qxF -- "$vol" "$VOLUMES_FILE" 2>/dev/null && continue
    fail "the Docker volume ${vol%% *} of the Compose project \"$PROJECT\" has no containers, and this install has no record of creating it, so it may hold another install's database. Nothing was changed. If it belongs to another install, give this install its own name with COMPOSE_PROJECT_NAME in $ENV_FILE, or in the environment before the first install. If it is this install's own data, run the command again with LIGHTHOUSE_VOLUMES_ARE_MINE=1 in the environment."
  done <<EOF
$vols
EOF
}

# Run after this script started the containers: the project's volumes are now this install's.
record_volumes() {
  local vols; vols=$(project_volumes) || exit 1
  (umask 077; printf '%s\n' "$vols" > "$VOLUMES_FILE")
}

is_tty() { [ -t 1 ] && { : </dev/tty; } 2>/dev/null; }

ask_yes() { # ask_yes "question": yes returns 0; without a terminal the answer is no
  local reply=
  is_tty || return 1
  printf '%s [y/N] ' "$1" >/dev/tty
  IFS= read -r reply </dev/tty || return 1
  case "$reply" in y|Y|yes|Yes|YES) return 0 ;; *) return 1 ;; esac
}

check_docker() {
  command -v docker >/dev/null 2>&1 || fail "Docker is not installed. Install Docker Desktop (macOS) or Docker Engine (Linux): https://docs.docker.com/get-docker/"
  docker compose version >/dev/null 2>&1 || fail "Docker Compose v2 is missing. It comes with Docker Desktop; on Linux install the docker-compose-plugin package: https://docs.docker.com/compose/install/linux/"
  local out
  if ! out=$(docker info 2>&1 >/dev/null); then
    case "$out" in
      *"permission denied"*) fail "your user cannot reach the Docker daemon. Add it to the docker group (sudo usermod -aG docker \$USER), log out and back in, then run this again." ;;
      *) fail "Docker is installed but not running. Start Docker Desktop, or run: sudo systemctl start docker" ;;
    esac
  fi
}

port_free() {
  local port=$1
  [ "$port" = 3000 ] && return 1
  if command -v ss >/dev/null 2>&1; then
    [ -z "$(ss -Hltn "sport = :$port" 2>/dev/null)" ]
  elif command -v lsof >/dev/null 2>&1; then
    if lsof -nP -iTCP:"$port" -sTCP:LISTEN >/dev/null 2>&1; then return 1; fi
  elif (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
    return 1
  fi
}

TAKEN=" "
pick_port() { # pick_port preferred: the first free port from preferred upward, never 3000
  local port=$1
  while [ "$port" -lt 65535 ]; do
    case "$TAKEN" in
      *" $port "*) ;;
      *) if port_free "$port"; then TAKEN="$TAKEN$port "; PICKED=$port; return 0; fi ;;
    esac
    port=$((port + 1))
  done
  fail "no free port found from $1 upward"
}

random_hex() {
  if command -v openssl >/dev/null 2>&1; then openssl rand -hex 32
  else od -An -N32 -tx1 /dev/urandom | tr -d ' \n'; fi
}

image_tag() { # main -> latest; another branch or tag -> its name with / replaced
  case "$1" in main) echo latest ;; *) printf '%s\n' "$1" | tr '/' '-' ;; esac
}

write_env() {
  local api mcp dash ref=${LIGHTHOUSE_REF:-main}
  pick_port "${LIGHTHOUSE_API_PORT:-51821}"; api=$PICKED
  pick_port "${LIGHTHOUSE_MCP_PORT:-51822}"; mcp=$PICKED
  pick_port "${LIGHTHOUSE_DASHBOARD_PORT:-51823}"; dash=$PICKED
  (umask 077; cat > "$ENV_FILE" <<EOF
# Written by the Lighthouse installer. Edit, then run: lighthouse up
COMPOSE_PROJECT_NAME=$PROJECT
LIGHTHOUSE_BIND_ADDRESS=${LIGHTHOUSE_BIND_ADDRESS:-127.0.0.1}
LIGHTHOUSE_API_PORT=$api
LIGHTHOUSE_MCP_PORT=$mcp
LIGHTHOUSE_DASHBOARD_PORT=$dash
LIGHTHOUSE_SECRETS_DIR=./secrets
LIGHTHOUSE_REF=$ref
LIGHTHOUSE_REPO=${LIGHTHOUSE_REPO:-$DEFAULT_REPO}
LIGHTHOUSE_IMAGE_TAG=$(image_tag "$ref")
LIGHTHOUSE_BUILD=${LIGHTHOUSE_BUILD:-0}
EOF
  )
  say "Ports: dashboard $dash, API $api, MCP $mcp"
}

write_secrets() {
  local name
  mkdir -p "$SECRETS"
  chmod 700 "$SECRETS"
  for name in db-password dashboard-session-key t3-webhook-hmac; do
    [ -s "$SECRETS/$name" ] || (umask 077; random_hex | tr -d '\n' > "$SECRETS/$name")
  done
}

wait_healthy() { # wait_healthy "services" seconds
  local want=$1 limit=$2 waited=0 svc state bad
  while :; do
    bad=
    for svc in $want; do
      state=$(compose ps --format '{{.Health}}' "$svc" 2>/dev/null | head -n 1)
      [ "$state" = healthy ] || bad="$bad $svc"
    done
    [ -z "$bad" ] && return 0
    if [ "$waited" -ge "$limit" ]; then
      compose ps >&2 || true
      fail "these services were not healthy after ${limit}s:$bad. See: lighthouse logs"
    fi
    sleep 3
    waited=$((waited + 3))
  done
}

host_readable() { # rootful Docker on Linux writes the file as root; give it back to this user
  local name=$1
  [ -r "$SECRETS/$name" ] || compose exec -T api chown "$(id -u):$(id -g)" "/host-secrets/$name"
  chmod 600 "$SECRETS/$name"
}

issue_token() { # issue_token file command name kind
  local file=$1 command=$2 name=$3 kind=$4
  [ -s "$SECRETS/$file" ] && return 0
  rm -f "$SECRETS/$file"
  if ! compose exec -T api admin-entrypoint "$command" --name "$name" --kind "$kind" --token-file "/host-secrets/$file" >/dev/null 2>&1; then
    # An earlier install used this name and its token file is gone: issue a new principal.
    rm -f "$SECRETS/$file"
    compose exec -T api admin-entrypoint "$command" --name "$name-$(date +%Y%m%d%H%M%S)" --kind "$kind" --token-file "/host-secrets/$file" >/dev/null
  fi
  host_readable "$file"
}

local_address() {
  local addr; addr=$(env_get LIGHTHOUSE_BIND_ADDRESS)
  case "$addr" in ""|0.0.0.0) echo 127.0.0.1 ;; *) echo "$addr" ;; esac
}
api_base() { echo "http://$(local_address):$(env_get LIGHTHOUSE_API_PORT)"; }
dashboard_url() { echo "http://$(local_address):$(env_get LIGHTHOUSE_DASHBOARD_PORT)"; }

# GET with a bearer token. curl reads the header from stdin, so the token never shows in `ps`.
auth_get() { # auth_get url token_file
  { printf 'Authorization: Bearer '; tr -d '\r\n' < "$2"; printf '\n'; } | curl -fsS -H @- "$1"
}

check_owner_token() {
  command -v curl >/dev/null 2>&1 || return 0
  local body
  body=$(auth_get "$(api_base)/api/v1/me" "$SECRETS/owner-token") \
    || fail "the API did not accept the owner token in $SECRETS/owner-token"
  case "$body" in *'"kind":"user"'*) ;; *) fail "the owner token does not belong to a user" ;; esac
}

pull_images() {
  # postgres is pulled by `up` only when missing, so an existing postgres tag on this machine,
  # which other projects may use, is never moved to a newer image.
  docker image inspect postgres:17.11-alpine >/dev/null 2>&1 || : > "$ROOT/.pulled-postgres"
  if [ "$(env_get LIGHTHOUSE_BUILD)" = 1 ]; then
    step "Building the images from source (a few minutes)"
    compose build
    return
  fi
  step "Downloading the images"
  compose pull --quiet migrate api mcp worker dashboard || fail "could not download the Lighthouse images. Check the network, or build them here instead: LIGHTHOUSE_BUILD=1 $ROOT/bin/lighthouse install"
}

start_stack() {
  step "Starting the database and applying migrations"
  compose up -d db api
  record_volumes
  wait_healthy "db api" 240
  compose logs --no-log-prefix migrate 2>/dev/null | tail -n 2 | sed 's/^/    /'
  step "Creating the owner and agent tokens"
  issue_token owner-token bootstrap owner user
  issue_token agent-token issue-principal agent agent
  check_owner_token
  step "Starting the MCP server, worker, and dashboard"
  compose up -d
  wait_healthy "$SERVICES_HEALTHY" 240
}

link_command() { # put `lighthouse` on PATH when ~/.local/bin is already there
  case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) return 0 ;; esac
  [ -e "$LINK" ] && [ ! -L "$LINK" ] && return 0
  mkdir -p "$HOME/.local/bin"
  ln -sfn "$ROOT/bin/lighthouse" "$LINK"
}

manage_command() {
  if [ "$(readlink "$LINK" 2>/dev/null)" = "$ROOT/bin/lighthouse" ]; then echo lighthouse; else echo "$ROOT/bin/lighthouse"; fi
}

success_box() {
  local cmd; cmd=$(manage_command)
  cat <<EOF

  +--------------------------------------------------------------------+
    T3 Lighthouse is running

    Dashboard   $(dashboard_url)
    Sign in     $(cat "$SECRETS/owner-token")

    The token is saved in $SECRETS/owner-token
    Commands    $cmd help
  +--------------------------------------------------------------------+

EOF
}

collector_python() {
  local py
  for py in "${LIGHTHOUSE_PYTHON:-}" python3.13 python3.12 python3.11 python3; do
    [ -n "$py" ] || continue
    py=$(command -v "$py" 2>/dev/null) || continue
    "$py" -c 'import sys; sys.exit(sys.version_info < (3, 11))' 2>/dev/null && { echo "$py"; return 0; }
  done
  return 1
}

# The collector script in the existing LaunchAgent, when it is not this install's.
other_collector() {
  [ -f "$COLLECTOR_PLIST" ] || return 1
  grep -qF "<string>$COLLECTOR_SCRIPT</string>" "$COLLECTOR_PLIST" && return 1
  sed -n 's|.*<string>\([^<]*collector\.py\)</string>.*|\1|p' "$COLLECTOR_PLIST" | head -n 1
  return 0
}

install_collector() { # install_collector api_url agent_token_file replace(0|1)
  local url=${1%/} token_file=$2 replace=${3:-0} py hostport host port other dir="$HOME/.config/lighthouse/secrets"
  [ "$(uname -s)" = Darwin ] || fail "the collector runs on macOS only"
  if other=$(other_collector); then
    say "This Mac already runs a Lighthouse collector from another folder: ${other:-unknown}"
    say "Installing this one replaces it and its agent token."
    if [ "$replace" != 1 ]; then
      if is_tty; then
        ask_yes "Replace it with the collector from $ROOT?" || fail "the existing collector was kept and nothing was changed"
      else
        fail "the existing collector was kept and nothing was changed. To replace it, run this again with --replace-collector."
      fi
    fi
  fi
  py=$(collector_python) || fail "the collector needs Python 3.11 or later, and the python3 that comes with macOS is older. Install one with Homebrew (brew install python@3.12) or from https://www.python.org/downloads/macos/, then run: $(manage_command) collector"
  curl -fsS "$url/healthz" >/dev/null 2>&1 || fail "cannot reach the Lighthouse API at $url"
  case "$(auth_get "$url/api/v1/me" "$token_file" 2>/dev/null)" in
    *'"kind":"agent"'*) ;;
    *) fail "the API at $url did not accept the agent token in $token_file" ;;
  esac
  mkdir -p "$dir"
  chmod 700 "$HOME/.config/lighthouse" "$dir"
  if [ "$token_file" != "$dir/agent-token" ]; then
    rm -f "$dir/agent-token"
    (umask 077; cp "$token_file" "$dir/agent-token")
  fi
  chmod 600 "$dir/agent-token"
  hostport=${url#http://}; hostport=${hostport%%/*}
  host=${hostport%:*}; port=${hostport##*:}
  [ "$host" != "$hostport" ] || port=80
  step "Installing the Mac collector (LaunchAgent ai.lighthouse.collector, $py)"
  LIGHTHOUSE_PYTHON="$py" "$ROOT/scripts/install-mac-collector.sh" --host "$host" --port "$port" --token-file "$dir/agent-token" --replace-collector
  say "The collector logs to ~/.config/lighthouse/collector.log"
  if t3_installed; then
    say "T3 Code found: the collector links your T3 projects, threads, and subagents."
    cmd_t3_connect || say "Stall notices will not go into T3 threads yet. To retry: $(manage_command) t3-connect"
  fi
}

t3_installed() { [ -d "$T3_HOME/userdata" ]; }

cmd_t3_connect() { # cmd_t3_connect [--disconnect | --pairing-code-stdin]
  local py
  [ "$(uname -s)" = Darwin ] || fail "T3 Code notices are set up on the Mac that runs T3 Code"
  py=$(collector_python) || fail "connecting to T3 needs Python 3.11 or later (brew install python@3.12)"
  if [ "${1:-}" = --disconnect ]; then
    T3_MCP_TOKEN_FILE="$T3_TOKEN_FILE" "$py" "$ROOT/collector/t3_connect.py" --disconnect
    rm -f "$T3_MARKER"
    return
  fi
  step "Connecting to T3 Code, so stall notices for T3 subagents go into their parent thread"
  T3_MCP_TOKEN_FILE="$T3_TOKEN_FILE" "$py" "$ROOT/collector/t3_connect.py" "$@" || return 1
  printf '%s\n' "$ROOT" > "$T3_MARKER"
}

maybe_collector() { # maybe_collector yes|no|ask replace(0|1)
  [ "$(uname -s)" = Darwin ] || return 0
  local choice=$1 replace=$2
  if [ "$choice" = ask ] && ! is_tty; then
    say "No terminal to ask in, so the Mac collector was not installed. To add it: $(manage_command) collector"
    return 0
  fi
  if [ "$choice" = ask ]; then
    say "The Mac collector sends session metadata from Claude Code, Codex, and the desktop apps on"
    say "this Mac to Lighthouse. It never sends message text. The README lists exactly what it sends."
    if t3_installed; then
      say "T3 Code is installed: the collector also reads T3's project and thread list, and connects"
      say "to T3 so stall notices for T3 subagents go into the parent thread."
    fi
    if ask_yes "Install the Mac collector now?"; then choice=yes; else choice=no; fi
  fi
  if [ "$choice" = yes ]; then
    install_collector "$(api_base)" "$SECRETS/agent-token" "$replace"
  else
    say "Mac collector not installed. To add it later: $(manage_command) collector"
  fi
}

cmd_install() {
  local demo=0 collector=ask collector_only=0 api_url='' token_file='' replace=0
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --demo) demo=1 ;;
      --with-collector) collector=yes ;;
      --no-collector) collector=no ;;
      --collector-only) collector_only=1 ;;
      --replace-collector) replace=1 ;;
      --api-url) api_url=${2:-}; shift ;;
      --api-url=*) api_url=${1#*=} ;;
      --agent-token-file) token_file=${2:-}; shift ;;
      --agent-token-file=*) token_file=${1#*=} ;;
      --build) export LIGHTHOUSE_BUILD=1 ;;
      *) fail "unknown option $1 (see --help)" ;;
    esac
    shift
  done

  if [ "$collector_only" = 1 ]; then
    if [ -z "$api_url" ] || [ -z "$token_file" ]; then fail "--collector-only needs --api-url and --agent-token-file"; fi
    [ -s "$token_file" ] || fail "the agent token file $token_file is missing or empty"
    install_collector "$api_url" "$token_file" "$replace"
    return
  fi

  check_docker
  check_project_owner
  if [ -f "$ENV_FILE" ] && [ -s "$SECRETS/owner-token" ]; then
    say "Lighthouse is already installed in $ROOT. Keeping its data, settings, and tokens."
    compose up -d
    record_volumes
    wait_healthy "$SERVICES_HEALTHY" 240
    check_owner_token
  else
    step "Writing the configuration"
    [ -f "$ENV_FILE" ] || write_env
    write_secrets
    pull_images
    start_stack
  fi
  link_command
  [ "$demo" = 1 ] && cmd_demo load
  success_box
  maybe_collector "$collector" "$replace"
}

cmd_demo() {
  local action=${1:-load}
  case "$action" in load|remove) ;; *) fail "usage: lighthouse demo [remove]" ;; esac
  compose exec -T api python -m lighthouse.demo "$action"
}

cmd_update() {
  check_docker
  check_project_owner
  local ref tmp repo; ref=$(env_get LIGHTHOUSE_REF); ref=${ref:-main}
  repo=${LIGHTHOUSE_REPO:-$(env_get LIGHTHOUSE_REPO)}; repo=${repo:-$DEFAULT_REPO}
  if [ "${1:-}" != --fetched ]; then
    step "Downloading the latest $ref"
    if [ -d "$ROOT/.git" ]; then
      git -C "$ROOT" fetch --quiet origin "$ref"
      git -C "$ROOT" merge --quiet --ff-only FETCH_HEAD || fail "local changes in $ROOT block the update; commit or discard them first"
    else
      tmp=$(mktemp -d "${TMPDIR:-/tmp}/lighthouse.XXXXXX")
      curl -fsSL "https://codeload.github.com/$repo/tar.gz/$ref" -o "$tmp/src.tar.gz" \
        || { rm -rf "$tmp"; fail "download of $repo ($ref) failed"; }
      tar -xzf "$tmp/src.tar.gz" -C "$ROOT" --strip-components 1
      rm -rf "$tmp"
    fi
    # Finish with the script that was just downloaded, not this older copy.
    exec "$ROOT/bin/lighthouse" update --fetched
  fi
  pull_images
  step "Restarting (migrations run on start)"
  compose up -d --remove-orphans
  record_volumes
  wait_healthy "$SERVICES_HEALTHY" 240
  remove_old_images
  say "Lighthouse is up to date: $(dashboard_url)"
}

remove_old_images() { # images an earlier version used that no tag points to any more
  local n; n=$(docker images -q --filter dangling=true --filter "label=$IMAGE_LABEL" | wc -l | tr -d ' ')
  [ "$n" = 0 ] && return 0
  docker image prune --force --filter "label=$IMAGE_LABEL" >/dev/null
  say "Removed $n old Lighthouse image(s)"
}

# macOS: remove the collector only if this install set it up. A collector from another folder,
# the briefs LaunchAgent, and files this install did not write are kept.
remove_collector() {
  [ "$(uname -s)" = Darwin ] || return 0
  local agents="$HOME/Library/LaunchAgents" conf="$HOME/.config/lighthouse" plist=$COLLECTOR_PLIST left own_plist=0
  if [ -f "$plist" ]; then
    if grep -qF "<string>$COLLECTOR_SCRIPT</string>" "$plist"; then
      own_plist=1
      launchctl bootout "gui/$(id -u)/ai.lighthouse.collector" 2>/dev/null || true
      rm -f "$plist"
      say "Removed LaunchAgent ai.lighthouse.collector"
    else
      say "Kept LaunchAgent ai.lighthouse.collector: it runs a collector from another folder"
    fi
  fi
  [ -f "$agents/ai.lighthouse.briefs.plist" ] && say "Kept LaunchAgent ai.lighthouse.briefs: you set it up by hand, so remove it by hand"
  [ -d "$conf" ] || return 0
  if [ "$(cat "$T3_MARKER" 2>/dev/null)" = "$ROOT" ]; then
    # Revoke the T3 token with T3's own command when it is there, then delete it.
    local py; py=$(collector_python) && T3_MCP_TOKEN_FILE="$T3_TOKEN_FILE" "$py" "$ROOT/collector/t3_connect.py" --disconnect >/dev/null 2>&1 || true
    rm -f "$T3_TOKEN_FILE" "$T3_MARKER"
    say "Removed the T3 Code connection"
  fi
  # The token, state, and log are shared by whichever collector runs; they are this install's only
  # when both the LaunchAgent and the marker name this folder.
  if [ "$(cat "$COLLECTOR_MARKER" 2>/dev/null)" = "$ROOT" ]; then
    if [ "$own_plist" = 1 ]; then
      rm -f "$conf/secrets/agent-token" "$conf/collector-state.json" "$conf/collector.log"
    else
      say "Kept the collector token, state, and log: the collector LaunchAgent does not run this install's collector"
    fi
    rm -f "$COLLECTOR_MARKER"
    rmdir "$conf/secrets" 2>/dev/null || true
    rmdir "$conf" 2>/dev/null || true
  fi
  if [ -d "$conf" ]; then
    left=$(cd "$conf" && find . -type f | sed 's|^\./||' | sort | tr '\n' ' ')
    say "Kept $conf, which this install did not create or still holds other files: ${left:-empty folders}"
  else
    say "Removed $conf"
  fi
}

cmd_uninstall() {
  local yes=0 reply='' images img
  for arg in "$@"; do [ "$arg" = --yes ] && yes=1; done
  if [ "$yes" != 1 ]; then
    say "This deletes the Lighthouse containers, images, database, tokens, and $ROOT,"
    say "and the Mac collector if this install set it up."
    is_tty || fail "nothing removed. Run it again with --yes to confirm."
    printf 'Type "delete" to continue: ' >/dev/tty
    IFS= read -r reply </dev/tty || true
    [ "$reply" = delete ] || fail "nothing removed"
  fi
  if [ -f "$ENV_FILE" ]; then
    # The database lives in a Docker volume. Delete the folder only after Docker removed it, so a
    # stopped Docker never leaves a database behind without the settings and tokens to reach it.
    if ! command -v docker >/dev/null 2>&1 || ! docker info >/dev/null 2>&1; then
      fail "Docker is not running, so the containers and the database could not be removed. Nothing was deleted. Start Docker and run uninstall again. (If you removed Docker on purpose, delete $ROOT by hand.)"
    fi
    check_project_owner
    images=$(compose config --images 2>/dev/null | sort -u)
    step "Removing the containers and the database volume"
    compose down --volumes --remove-orphans || fail "Docker could not remove the containers. Nothing else was deleted; run uninstall again."
    step "Removing the images"
    for img in $images; do
      # Keep postgres if it was already here before Lighthouse; Docker also refuses to
      # remove an image that another container still uses.
      case "$img" in postgres:*) [ -f "$ROOT/.pulled-postgres" ] || { say "    kept $img (it was here before Lighthouse)"; continue; } ;; esac
      if docker image rm "$img" >/dev/null 2>&1; then say "    removed $img"; else say "    kept $img (in use or already gone)"; fi
    done
    remove_old_images
  fi
  remove_collector
  [ "$(readlink "$LINK" 2>/dev/null)" = "$ROOT/bin/lighthouse" ] && rm -f "$LINK"
  step "Removing $ROOT"
  cd /
  rm -rf "$ROOT"
  say "Lighthouse is uninstalled."
}

main() {
  local command=${1:-help}
  [ "$#" -gt 0 ] && shift
  case "$command" in
    install) cmd_install "$@" ;;
    up) check_docker; check_project_owner; compose up -d; record_volumes; wait_healthy "$SERVICES_HEALTHY" 240; say "Dashboard: $(dashboard_url)" ;;
    down) check_project_owner; compose down ;;
    status) compose ps; say ""; say "Dashboard: $(dashboard_url)" ;;
    logs) compose logs -f --tail 100 "$@" ;;
    token) cat "$SECRETS/owner-token"; echo ;;
    agent-token) cat "$SECRETS/agent-token"; echo ;;
    demo) cmd_demo "$@" ;;
    collector)
      case "${1:-}" in "") replace=0 ;; --replace-collector) replace=1 ;; *) fail "usage: lighthouse collector [--replace-collector]" ;; esac
      install_collector "$(api_base)" "$SECRETS/agent-token" "$replace" ;;
    t3-connect) cmd_t3_connect "$@" ;;
    update) cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    help|-h|--help) usage ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
